lumn":"LEFT","attributes":[{"id":"Fabricante","text":"Payot"},{"id":"Marca","text":"Kamaia - Boca Rosa Beauty by Payot"},{"id":"Linha","text":"Boca Rosa Beauty"},{"id":"Nome","text":"Base Mate Líquida"},{"id":"Modelo","text":"Boca Rosa Beauty Base Mate Líquida"},{"id":"Tom","text":"TOM 3 - FRANCISCA"},{"id":"Volume da unidade","text":"30 mL"}],"heading_label":{"text":"Características principais","is_heading":true}},{"title":"Peso","type":"TITLE_STRIPED","column":"RIGHT","attributes":[{"id":"Peso da unidade","text":"35 g"}],"heading_label":{"text":"Peso","is_heading":true}},{"title":"Características de venda","type":"TITLE_STRIPED","column":"RIGHT","attributes":[{"id":"Formato de venda","text":"Unidade"}],"heading_label":{"text":"Características de venda","is_heading":true}},{"title":"Outros","type":"TITLE_STRIPED","column":"RIGHT","attributes":[{"id":"Acabamento","text":"Mate"},{"id":"Cobertura","text":"Média"},{"id":"Tipo de pele","text":"Todo tipo de pele"},{"id":"Com proteção solar","text":"Não"},{"id":"É antienvelhecimento","text":"Não"},{"id":"Formato do produto","text":"Líquida"},{"id":"É antiacne","text":"Não"},{"id":"É à prova d'água","text":"Não"},{"id":"É de longa duração","text":"Sim"},{"id":"É hidratante","text":"Não"},{"id":"É um produto hipoalergênico","text":"Não"},{"id":"É livre de glúten","text":"Não"},{"id":"É vegano","text":"Não"},{"id":"É livre de crueldade","text":"Sim"},{"id":"É livre de parabenos","text":"Sim"},{"id":"É dermatologicamente testado","text":"Sim"},{"id":"É comedogênico","text":"Sim"}],"heading_label":{"text":"Outros","is_heading":true}}],"action":{"timeout":0,"duration":0,"label":{"text":"Conferir todas as características","color":"BLUE"},"track":{"melidata_event":{"path":"\u002Fupp\u002Ftechnical_specs\u002Fview_more","event_data":{"catalog_product_id":"MLB7166820996","item_id":"MLB7166820996","category_id":"MLB29871","domain_id":"MLB-FOUNDATIONS","seller_id":2059266388,"is_highlighted":true,"user_product_id":"MLBU4323656014","page_type":"UPP","pid":"MLBU4323656014","pid_extended":"MLBU4323656014_MLB7166820996","pid_version":"0.6.0","pid_family":"MLBU7126790410610833"}}}},"max_groups":1}],"viewport_track":{"melidata_event":{"type":"view","path":"\u002Fupp\u002Fshow_technical_specs","event_data":{"catalog_product_id":"MLB7166820996","item_id":"MLB7166820996","category_id":"MLB29871","domain_id":"MLB-FOUNDATIONS","seller_id":2059266388,"is_highlighted":true,"user_product_id":"MLBU4323656014","page_type":"UPP","pid":"MLBU4323656014","pid_extended":"MLBU4323656014_MLB7166820996","pid_version":"0.6.0","pid_family":"MLBU7126790410610833"}}}},"description":{"id":"description","type":"description","state":"VISIBLE","title":"Descrição","content":"A Base Mate Boca Rosa Beauty by Payot é uma base de alta cobertura que proporciona um acabamento mate sem deixar a pele ressecada ou craquelada. Desliza facilmente na pele e proporciona uma cobertura perfeita.\nÉ de longa duração e resistente à água.\nSâo 9 cores subdividas em 3 tons: claro, médio e escuro.\n\nA segunda fase da linha Boca Rosa Beauty by Payot:\nCom um ano de lançamento em outubro\u002F2019, a coleção Boca Rosa Beauty by Payot cresceu! A coleção que contava com 29 itens, agora expandiu para mais 19 itens!\n“Quem me acompanha sabe o quanto sonhei em lançar minha própria linha de maquiagem”, comenta a influenciadora, “Me senti muito lisonjeada em ter sido escolhida pela Payot para assinar um projeto tão incrível”.\nA coleção conta com 9 tons de bases, que vão dos mais claros até os tons de pele negras, 5 tons de corretivos, que possuem a mesma proposta das bases, três cores de pó facial solto, bruma e primer.\n\nPrincipais Benefícios:\n• Proporciona alta cobertura.\n• Espalha facilmente promovendo o efeito desejado.\n• Não craquela.\n• Longa Duração\n• Resistência à água\n\nModo de uso:\nApós higienização da pele e primer lágrima rose gold, aplicar a base de maneira uniforme usando um pincel, esponja ou os dedos.\n\nIndicação:\n• Para todos os tipos de pele.\nProduto hipoalergênico e dermatologicamente testado.\n\nSem garantia","action":{"timeout":0,"duration":0,"label":{"text":"Ver descrição completa"},"target":"https:\u002F\u002Fwww.mercadolivre.com.br\u002Fdescription"},"collapsable":{"collapse_by":"pixels","height":400},"show_track":{"melidata_event":{"type":"event","path":"\u002Fupp\u002Fshow_description","event_data":{"user_product_id":"MLBU4323656014","pid":"MLBU4323656014","pid_extended":"MLBU4323656014_MLB7166820996","pid_version":"0.6.0","pid_family":"MLBU7126790410610833"}}},"heading_label":{"text":"Descrição","is_heading":true},"has_divider":true},"highlighted_specs_features":{"id":"highlighted_specs_features","type":"highlighted_specs","state":"VISIBLE","components":[{"id":"highlighted_features_title","type":"label_component","state":"VISIBLE","label":{"text":"O que você precisa saber sobre este produto","color":"BLACK","font_size":"XSMALL","font_family":"SEMIBOLD"},"alignment":"left","heading_label":{"text":"O que você precisa saber sobre este produto","color":"BLACK","font_size":"XSMALL","font_family":"SEMIBOLD","is_heading":true}},{"id":"highlighted_features","type":"highlighted_features","state":"VISIBLE","bullet":"•","features":[{"text":"Peso da unidade: 35 g","color":"BLACK","font_size":"XSMALL","font_family":"REGULAR"},{"text":"Volume da unidade: 30 mL","color":"BLACK","font_size":"XSMALL","font_family":"REGULAR"},{"text":"Quantidade de bases faciais maquillaje: 1","color":"BLACK","font_size":"XSMALL","font_family":"REGULAR"},{"text":"Proporciona acabamento mate.","color":"BLACK","font_size":"XSMALL","font_family":"REGULAR"},{"text":"Fornece uma cobertura média.","color":"BLACK","font_size":"XSMALL","font_family":"REGULAR"},{"text":"Adequada para todos os tipos de pele.","color":"BLACK","font_size":"XSMALL","font_family":"REGULAR"},{"text":"É livre de crueldade.","color":"BLACK","font_size":"XSMALL","font_family":"REGULAR"},{"text":"Aperfeiçoa a pele e unifica o tom do seu rosto.","c