pp-striped-specs__row__column" id="_R_advrim8l6bcara_"><span id="_R_advrim8l6bcara_-value" class="andes-table__column--value" style="line-clamp:none;-webkit-line-clamp:none">Sim</span></td></tr><tr class="andes-table__row ui-vpp-striped-specs__row"><th class="andes-table__header andes-table__header--left ui-vpp-striped-specs__row__column ui-vpp-striped-specs__row__column--id" scope="row"><div class="andes-table__header__container">É dermatologicamente testado</div></th><td class="andes-table__column andes-table__column--left andes-table__column--vertical-align-center ui-vpp-striped-specs__row__column" id="_R_ae3rim8l6bcara_"><span id="_R_ae3rim8l6bcara_-value" class="andes-table__column--value" style="line-clamp:none;-webkit-line-clamp:none">Sim</span></td></tr><tr class="andes-table__row ui-vpp-striped-specs__row"><th class="andes-table__header andes-table__header--left ui-vpp-striped-specs__row__column ui-vpp-striped-specs__row__column--id" scope="row"><div class="andes-table__header__container">É comedogênico</div></th><td class="andes-table__column andes-table__column--left andes-table__column--vertical-align-center ui-vpp-striped-specs__row__column" id="_R_ae7rim8l6bcara_"><span id="_R_ae7rim8l6bcara_-value" class="andes-table__column--value" style="line-clamp:none;-webkit-line-clamp:none">Sim</span></td></tr></tbody></table></div></div></div></div><button data-testid="action-collapsable-target" class="ui-pdp-collapsable__action ui-vpp-highlighted-specs__striped-collapsed__action" type="button">Conferir todas as características<span translate="no" class="ui-pdp-icon-wrapper"><svg class="ui-pdp-icon ui-pdp-icon--chevron ui-pdp-collapsable__chevron ui-pdp-icon--chevron-down" viewBox="0 0 9 14" xmlns="http://www.w3.org/2000/svg"><use href="#chevron"></use></svg></span></button></div></div></section></div></div><div class="ui-pdp-container__row"><div class="ui-pdp-container__col col-1 pl-24 pr-24"></div></div><div class="ui-pdp-container__row"><div class="ui-pdp-container__col col-1 pl-24 pr-24"></div></div><div class="ui-pdp-container__row"><div class="ui-pdp-container__col col-1"></div></div><div class="ui-pdp-container__row"><div class="ui-pdp-container__col col-1 pl-24 pr-24"><div class="ui-pdp-collapsable mt-24 ui-pdp-description-collapse ui-pdp-collapsable--is-collapsed"><div class="ui-pdp-collapsable__container" style="max-height: 400px;"><div id="description" class="ui-pdp-description"><h2 class="ui-pdp-description__title">Descrição</h2><p class="ui-pdp-description__content">A Base Mate Boca Rosa Beauty by Payot é uma base de alta cobertura que proporciona um acabamento mate sem deixar a pele ressecada ou craquelada. Desliza facilmente na pele e proporciona uma cobertura perfeita.
É de longa duração e resistente à água.
Sâo 9 cores subdividas em 3 tons: claro, médio e escuro.

A segunda fase da linha Boca Rosa Beauty by Payot:
Com um ano de lançamento em outubro/2019, a coleção Boca Rosa Beauty by Payot cresceu! A coleção que contava com 29 itens, agora expandiu para mais 19 itens!
“Quem me acompanha sabe o quanto sonhei em lançar minha própria linha de maquiagem”, comenta a influenciadora, “Me senti muito lisonjeada em ter sido escolhida pela Payot para assinar um projeto tão incrível”.
A coleção conta com 9 tons de bases, que vão dos mais claros até os tons de pele negras, 5 tons de corretivos, que possuem a mesma proposta das bases, três cores de pó facial solto, bruma e primer.

Principais Benefícios:
• Proporciona alta cobertura.
• Espalha facilmente promovendo o efeito desejado.
• Não craquela.
• Longa Duração
• Resistência à água

Modo de uso:
Após higienização da pele e primer lágrima rose gold, aplicar a base de maneira uniforme usando um pincel, esponja ou os dedos.

Indicação:
• Para todos os tipos de pele.
Produto hipoalergênico e dermatologicamente testado.

